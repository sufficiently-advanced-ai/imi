# Lane admission (ADR-003): which lane each intake source defaults to.
# Copy to config/lanes.yaml to override the built-in defaults in
# app/services/lane_admission.py (SOURCE_DEFAULTS). Values:
#   record    — we were party to it (meetings, own notes, business comms)
#   library   — third-party content we watch (feeds, articles, videos)
#   per_item  — mixed; the decision model (op `lane_admission`) judges each item
# Unknown sources are per_item. With the model off or failing, per_item falls
# back to record (the pre-lanes behaviour).
#
# Built-in connector names for agent intake (ADR-007): gmail and gdrive are
# per_item, gcal and slack are record, web and rss are library. mail / email
# stay per_item alongside gmail.

# Whose knowledge base this is — used in the model's lane questions.
# Defaults to the KB_OWNER_NAME setting.
# owner: Your Name

sources:
  littlebird: record
  ai-circle-inbox: record
  mail: per_item
  web: library

# Agent-mediated intake (ADR-007). Content that arrives over MCP
# (capture_thought, add_call_transcript) names its source itself, so on that
# channel a record-default source is judged per item instead of trusted —
# unless it is listed here. Default: empty (nothing trusted).
#
# A judged first-party note still lands in record (the model files it as
# memory); what this list changes is that an agent can't *assert* record.
# Only takes effect with a judge configured: with `lane_admission` off in
# config/inference.yaml, per_item falls back to record anyway.
#
# A single-user instance where "remember this" is always first-party might use:
# mcp_trusted_sources: [manual]
mcp_trusted_sources: []

# Extra senders to drop at admission (substring match on the From: line),
# on top of the built-in automated-mail rule (DMARC reports, statements).
drop_senders:
  - notifications@example-vendor.com

# ---- Library and recall policy (ADR-006) ------------------------------------
# Every key is optional; the values below are the defaults and reproduce
# ADR-003 exactly. A bad value is logged and replaced by its default — it never
# breaks intake. Fixed regardless of this policy: the lane is server-assigned,
# library produces attributed `claim` signals only (never decisions or action
# items), is never instruction-grade, never feeds entity profiles as fact, and
# decay hides a record from recall without deleting it.
library:
  decay:
    enabled: true                 # false: library never goes stale (stamped
                                  # horizons are kept, just ignored)
    horizons_days: [90, 180, 365] # low / medium / high durability; unjudged
                                  # items get the middle one
  entities:
    mode: link_only               # link_only: link to existing entities only
                                  # allowlist: may also create create_types,
                                  #   through the resolver and entity admission
    create_types: []              # e.g. [organization] — must be entity types
                                  # of the active domain (case-insensitive)
  infer_relationships: false      # true: infer entity relationships from
                                  # library content too
  # Types a claim's source (authors / publisher) resolves to, in order.
  # Default: whichever of person, contact, organization, company the domain has.
  # attribution_types: [person, organization]
recall:
  default_lanes: [record]         # e.g. [record, library]: library hits are
                                  # ranked separately under `background`

# A library-primary deployment (research firm, policy shop) might use:
# library:
#   decay: {enabled: false}
#   entities: {mode: allowlist, create_types: [organization]}
# recall:
#   default_lanes: [record, library]
